<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zjjh.fdtemp.dao.SysPostDao">

	<resultMap type="SysPost" id="SysPostResult">
		<id     property="id"            column="ID"            />
		<result property="postCode"      column="post_code"     />
		<result property="postName"      column="post_name"     />
		<result property="postSort"      column="post_sort"     />
		<result property="status"        column="status"        />
		<result property="createUser"    column="CREATE_USER"   />
		<result property="createUserNickname" column="CREATE_USER_NICKNAME" />
		<result property="createTime"    column="CREATE_TIME"   />
		<result property="updateUser"    column="UPDATE_USER"   />
		<result property="updateUserNickname" column="UPDATE_USER_NICKNAME" />
		<result property="updateTime"    column="UPDATE_TIME"   />
		<result property="attr1"         column="ATTR1"         />
	</resultMap>

	<sql id="selectPostVo">
        select ID, post_code, post_name, post_sort, status, CREATE_USER, CREATE_TIME, ATTR1
		from sys_post
    </sql>

	<select id="selectPostList" parameterType="SysPost" resultMap="SysPostResult">
	    <include refid="selectPostVo"/>
		<where>
			<if test="postCode != null and postCode != ''">
				AND post_code like concat('%', #{postCode}, '%')
			</if>
			<if test="status != null and status != ''">
				AND status = #{status}
			</if>
			<if test="postName != null and postName != ''">
				AND post_name like concat('%', #{postName}, '%')
			</if>
		</where>
	</select>

	<select id="selectPostAll" resultMap="SysPostResult">
		<include refid="selectPostVo"/>
	</select>

	<select id="selectPostsByUserId" parameterType="String" resultMap="SysPostResult">
		SELECT p.ID, p.post_name, p.post_code
		FROM sys_user u
			 LEFT JOIN sys_user_post up ON u.ID = up.user_id
			 LEFT JOIN sys_post p ON up.post_id = p.ID
		WHERE up.user_id = #{userId}
	</select>

	<select id="selectPostById" parameterType="String" resultMap="SysPostResult">
		<include refid="selectPostVo"/>
		where ID = #{id}
	</select>

	<select id="checkPostNameUnique" parameterType="String" resultMap="SysPostResult">
		<include refid="selectPostVo"/>
		 where post_name=#{postName} limit 1
	</select>

	<select id="checkPostCodeUnique" parameterType="String" resultMap="SysPostResult">
		<include refid="selectPostVo"/>
		 where post_code=#{postCode} limit 1
	</select>

 	<delete id="deletePostByIds" parameterType="String">
 		delete from sys_post where ID in
 		<foreach collection="array" item="id" open="(" separator="," close=")">
 			#{id}
        </foreach>
 	</delete>

 	<update id="updatePost" parameterType="SysPost">
 		update sys_post
 		<set>
 			<if test="postCode != null and postCode != ''">post_code = #{postCode},</if>
 			<if test="postName != null and postName != ''">post_name = #{postName},</if>
 			<if test="postSort != null and postSort != ''">post_sort = #{postSort},</if>
 			<if test="status != null and status != ''">status = #{status},</if>
 			<if test="attr1 != null">ATTR1 = #{attr1},</if>
 			<if test="updateUser != null and updateUser != ''">UPDATE_USER = #{updateUser},</if>
 			<if test="updateUserNickname != null and updateUserNickname != ''">UPDATE_USER_NICKNAME = #{updateUserNickname},</if>
 			UPDATE_TIME = CURRENT_TIMESTAMP
 		</set>
 		where ID = #{id}
	</update>

 	<insert id="insertPost" parameterType="SysPost">
 		insert into sys_post(
 			<if test="id != null and id != ''">ID,</if>
 			<if test="postCode != null and postCode != ''">post_code,</if>
 			<if test="postName != null and postName != ''">post_name,</if>
 			<if test="postSort != null and postSort != ''">post_sort,</if>
 			<if test="status != null and status != ''">status,</if>
 			<if test="attr1 != null and attr1 != ''">ATTR1,</if>
 			<if test="createUser != null and createUser != ''">CREATE_USER,</if>
 			<if test="createUserNickname != null and createUserNickname != ''">CREATE_USER_NICKNAME,</if>
 			CREATE_TIME
 		)values(
 			<if test="id != null and id != ''">#{id},</if>
 			<if test="postCode != null and postCode != ''">#{postCode},</if>
 			<if test="postName != null and postName != ''">#{postName},</if>
 			<if test="postSort != null and postSort != ''">#{postSort},</if>
 			<if test="status != null and status != ''">#{status},</if>
 			<if test="attr1 != null and attr1 != ''">#{attr1},</if>
 			<if test="createUser != null and createUser != ''">#{createUser},</if>
 			<if test="createUserNickname != null and createUserNickname != ''">#{createUserNickname},</if>
 			CURRENT_TIMESTAMP
 		)
	</insert>

</mapper>